@using IdentityNET10.Extensions
@using IdentityNET10.Models.Enums
@model IdentityNET10.Models.ViewModels.LoginViewModel

<div class="row justify-content-center mt-4">
    <div class="col-lg-6 col-xl-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                </h3>
                <form asp-action="Login" method="POST">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="Password" class="form-control" placeholder="Contraseña" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Acceder
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <form asp-controller="Account" asp-action="ExternalLogin" method="POST">
                        <input type="hidden" name="provider" value="@ExternalProvider.Facebook.GetDisplayName()" />
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <button type="submit" class="btn btn-outline-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-facebook me-2"></i> Iniciar sesión con Facebook
                        </button>
                    </form>
                </div>

                <div class="text-center mt-4">
                    <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none">
                        <i class="bi bi-question-circle me-1"></i> ¿Olvidaste tu contraseña?
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
