@{
    ViewData["Title"] = "Correo no confirmado";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-envelope-exclamation-fill text-warning" style="font-size: 3.2rem;"></i>
                <h3 class="fw-bold mt-3 mb-3">Tu correo aún no ha sido confirmado</h3>
                <p class="text-muted">
                    Tus credenciales son correctas, pero necesitas confirmar tu correo electrónico antes de poder acceder a tu cuenta.
                </p>
                <p class="text-muted">
                    Revisa tu bandeja de entrada y sigue el enlace de confirmación que te enviamos al registrarte.
                </p>
                <div class="alert alert-info mt-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Si no encuentras el correo, revisa la carpeta de spam o correo no deseado.
                </div>
                <div class="d-grid mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Volver al inicio de sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>