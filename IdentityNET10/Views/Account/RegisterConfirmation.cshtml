@{
    ViewData["Title"] = "Registro exitoso";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-person-check-fill text-primary" style="font-size: 3.2rem;"></i>
                <h3 class="fw-bold mt-3 mb-3">¡Registro exitoso!</h3>
                <p class="text-muted">Tu cuenta ha sido creada correctamente.</p>
                <p class="text-muted">Para activar tu cuenta, hemos enviado un correo electrónico con un enlace de confirmación.</p>
                <div class="alert alert-info mt-4">
                    <i class="bi bi-info-circle me-1"></i>
                    Revisa tu bandeja de entrada y sigue las instrucciones para confirmar tu correo.
                </div>
                <p class="text-muted small">Si no encuentras el correo, revisa la carpeta de spam o correo no deseado.</p>
                <div class="d-grid mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Volver al inicio de sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>