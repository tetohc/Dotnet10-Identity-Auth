@model IdentityNET10.Models.ViewModels.TwoFactorAuthStatusViewModel

<div class="row justify-content-center mt-4">
    <div class="col-lg-8 col-xl-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 fw-bold">
                    <i class="bi bi-shield-lock-fill me-2"></i> Administración de Autenticación en Dos Pasos
                </h3>

                <div class="alert @(Model.IsEnabled ? "alert-info" : "alert-danger") text-center shadow-sm">
                    <i class="bi @(Model.IsEnabled ? "bi-check-circle" : "bi-x-circle") me-2"></i>
                    @(Model.IsEnabled ? "La autenticación en dos pasos está activada." : "La autenticación en dos pasos no está activada.")
                </div>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-key-fill me-2 text-primary"></i> Clave de autenticador configurada</span>
                        <span class="fw-bold">@((Model.HasAuthenticatorKey) ? "Sí" : "No")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-laptop me-2 text-info"></i> Navegador recordado</span>
                        <span class="fw-bold">@((Model.RememberBrowser) ? "Sí" : "No")</span>
                    </li>
                </ul>

                @if (Model.RecoveryCodes != null && Model.RecoveryCodes.Any())
                {
                    <div class="bg-light border rounded p-4 shadow-sm mb-4">
                        <h5 class="fw-bold mb-3 text-primary">
                            <i class="bi bi-key me-2"></i> Códigos de recuperación
                        </h5>
                        <div class="row g-3">
                            @foreach (var code in Model.RecoveryCodes)
                            {
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center p-3">
                                            <div class="fw-bold fs-5 text-dark">@code</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="form-text text-muted mt-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Guarda estos códigos en un lugar seguro. Cada uno se puede usar una sola vez.
                        </div>
                    </div>
                }

                <div class="d-grid gap-2">
                    @if (Model.IsEnabled)
                    {
                        <form asp-controller="Account" asp-action="DisableTwoFactorAuth" method="post">
                            <button type="submit" class="btn btn-primary btn w-100 shadow-sm">
                                <i class="bi bi-x-circle me-2"></i> Desactivar 2FA
                            </button>
                        </form>
                        <form asp-controller="Account" asp-action="GenerateRecoveryCodes" method="post">
                            <button type="submit" class="btn btn-secondary btn w-100 shadow-sm">
                                <i class="bi bi-key me-2"></i> Generar nuevos códigos de recuperación
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Account" asp-action="SetupTwoFactorAuth" method="post">
                            <button type="submit" class="btn btn-success btn-lg w-100 shadow-sm">
                                <i class="bi bi-shield-plus me-2"></i> Activar 2FA
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
