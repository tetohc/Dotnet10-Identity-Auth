@using IdentityNET10.Extensions
@using IdentityNET10.Models.Enums
@model IdentityNET10.Models.ViewModels.SignUpViewModel

<div class="row justify-content-center mt-4">
    <div class="col-lg-8 col-xl-6">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 fw-bold">
                    <i class="bi bi-person-plus-fill me-2"></i> Registro de Usuario
                </h3>
                <form asp-action="SignUp" method="POST">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Tu nombre completo" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="Contraseña" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-shield-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar contraseña" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Birthdate" class="form-label fw-semibold"></label>
                            <input asp-for="Birthdate" class="form-control" type="date" />
                            <span asp-validation-for="Birthdate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CountryCode" class="form-label fw-semibold"></label>
                            <input asp-for="CountryCode" class="form-control" placeholder="+506" />
                            <span asp-validation-for="CountryCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label fw-semibold"></label>
                            <input asp-for="Country" class="form-control" placeholder="Costa Rica" />
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold"></label>
                            <input asp-for="City" class="form-control" placeholder="Costa Rica" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Dirección completa"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-check-circle-fill me-2"></i> Registrarse
                        </button>
                    </div>
                </form>
                <div class="text-center mt-4">
                    <form asp-controller="Account" asp-action="ExternalLogin" method="POST">
                        <input type="hidden" name="provider" value="@ExternalProvider.Facebook.GetDisplayName()" />
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <button type="submit" class="btn btn-outline-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-facebook me-2"></i> Registrarse con Facebook
                        </button>
                    </form>
                </div>
                <div class="text-center mt-3">
                    <form asp-controller="Account" asp-action="ExternalLogin" method="POST">
                        <input type="hidden" name="provider" value="@ExternalProvider.Google.GetDisplayName()" />
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        <button type="submit" class="btn btn-outline-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-google me-2"></i> Registrarse con Google
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
