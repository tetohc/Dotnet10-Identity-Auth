@{
    ViewData["Title"] = "Error de confirmación";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-x-circle-fill text-danger" style="font-size: 3.2rem;"></i>
                <h3 class="fw-bold mt-3 mb-3">No se pudo confirmar tu correo</h3>
                <p class="text-muted">El enlace de confirmación no es válido o ha expirado.</p>
                <p class="text-muted">
                    Si necesitas un nuevo enlace, puedes solicitarlo nuevamente desde la página de inicio de sesión.
                </p>
                <div class="d-grid mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Ir al inicio de sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>