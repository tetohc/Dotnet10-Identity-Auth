@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <div class="mb-3">
                    <i class="bi bi-shield-exclamation text-danger" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="fw-bold mb-3 text-danger">Acceso denegado</h3>

                <p class="text-muted mb-4">
                    No tienes permisos para acceder a este recurso.  
                    Si crees que esto es un error, contacta al administrador del sistema.
                </p>

                <div class="d-grid gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-house-door-fill me-2"></i> Volver al inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
