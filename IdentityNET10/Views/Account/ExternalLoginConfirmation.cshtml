@model IdentityNET10.Models.ViewModels.ExternalLoginConfirmationViewModel

<div class="card shadow-sm border-0 mt-4">
    <div class="card-body p-4 text-center">
        <h3 class="fw-bold mb-3">Confirmación de inicio de sesión</h3>
        <p>Has iniciado sesión con tu cuenta de <strong>@Model.Provider</strong>.</p>
        <form asp-controller="Account" asp-action="ConfirmExternalLogin" method="post">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                Continuar
            </button>
        </form>
    </div>
</div>