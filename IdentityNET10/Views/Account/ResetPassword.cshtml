@model IdentityNET10.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6 col-xl-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="text-center mb-4 fw-bold">
                    <i class="bi bi-shield-lock-fill me-2"></i> Restablecer contraseña
                </h3>
                <form asp-action="ResetPassword" method="POST">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.Token)
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="Password" class="form-control" placeholder="Nueva contraseña" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar contraseña" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-arrow-repeat me-2"></i> Restablecer contraseña
                        </button>
                    </div>
                </form>
                <div class="text-center mt-4">
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none">
                        <i class="bi bi-box-arrow-in-left me-1"></i> Volver al inicio de sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
