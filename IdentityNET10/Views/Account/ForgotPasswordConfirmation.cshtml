@{
    ViewData["Title"] = "Recuperación enviada";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-envelope-check-fill text-success" style="font-size: 3rem;"></i>
                <h4 class="fw-bold mt-3 mb-2">Revisa tu correo</h4>
                <p class="text-muted">
                    Si el correo está registrado, hemos enviado un enlace para restablecer tu contraseña.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-3">
                    <i class="bi bi-house-door-fill me-1"></i> Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>
