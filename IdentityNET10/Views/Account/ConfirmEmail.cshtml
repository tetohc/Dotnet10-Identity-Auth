@{
    ViewData["Title"] = "Cuenta confirmada";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-6 col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3.2rem;"></i>
                <h3 class="fw-bold mt-3 mb-3">¡Tu cuenta ha sido confirmada!</h3>
                <p class="text-muted">
                    Gracias por verificar tu correo electrónico.  
                    Ahora puedes iniciar sesión y comenzar a utilizar la aplicación.
                </p>
                <div class="d-grid mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>